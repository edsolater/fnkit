{
  "compilerOptions": {
    "module": "esnext", //如果过于新，typescript就不会转换 export * as ns 的语法了
    "target": "ESNext", // 完全不考虑兼容性，按最新语义输出 / No compatibility concerns; emit with latest semantics
    "lib": ["ESNext", "ESNext.Iterator"],
    "types": ["node"], // 显式引入 Node 全局类型（含 console 等）/ Explicitly include Node globals (e.g. console)
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler", // 使用 Bundler 解析；避免 node10 弃用 / Bundler resolution; avoids deprecated node10
    "noImplicitAny": false,
    "strict": true,
    "outDir": "dist",
    "rootDir": "src", // 源码根目录固定为 src，避免映射路径漂移 / Keep source root stable to avoid map path drift
    "declaration": true, // see https://www.typescriptlang.org/docs/handbook/declaration-files/dts-from-js.html#tsconfig
    "declarationMap": true, // 让 .d.ts 可回跳源码；关闭会降低类型定位体验 / Enables source navigation from declarations
    "sourceMap": true, // 运行时代码可回溯源码；关闭后堆栈可读性下降 / Keeps runtime artifacts traceable to TS source
    "emitDeclarationOnly": false // 不能只发声明，还要配合构建产出 JS/map / Not declaration-only; JS/map outputs are also required
  },
  "include": ["src"] // 仅编译主源码，范围过大会引入噪音 / Compile only the library source scope
}
